# OpenStack Tempest All (tempest + full plugin set)
#
# Builds tempest, python-tempestconf, and all openstack-tempest-all
# equivalent plugins from source (see sources.txt for the full list).
# Config is generated at runtime via discover-tempest-config.
# Entrypoint: run_tempest.sh

ARG BASE_IMAGE=localhost/openstack/openstack-base:latest

# --- Build stage: compile wheels from source ---
FROM ${BASE_IMAGE} AS build

ARG CONSTRAINTS_FILE=requirements.lock
COPY ${CONSTRAINTS_FILE} /deps-upper-constraints.txt
COPY src/ /src/
COPY tempest-all/src/ /src/

ARG PIP_NO_BINARY=""
ENV PIP_NO_BINARY=${PIP_NO_BINARY}
ENV MATURIN_NO_INSTALL_RUST=true

COPY tempest-all/builddeps.txt /tmp/builddeps.txt
RUN pkgs=$(cat /tmp/builddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all; fi

COPY tempest-all/pythonbuilddeps.txt /tmp/pythonbuilddeps.txt
RUN pkgs=$(cat /tmp/pythonbuilddeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then pip3 install --no-cache-dir -c /deps-upper-constraints.txt ${pkgs}; fi && \
    rm /tmp/pythonbuilddeps.txt

# Generate a filtered constraints file that excludes packages we build from source.
RUN cp /deps-upper-constraints.txt /tmp/build-constraints.txt && \
    for src_dir in /src/*/ /src/overrides/*/; do \
      if [ -d "${src_dir}" ] && [ -f "${src_dir}/setup.cfg" ]; then \
        pkg_name=$(grep -m1 '^name' "${src_dir}/setup.cfg" | sed 's/.*=\s*//'); \
        sed -i "/^${pkg_name}[=!<>]/Id" /tmp/build-constraints.txt; \
      fi; \
    done

# Build wheels for all source packages (tempest + tempestconf + all plugins)
RUN for pkg in /src/*/ /src/overrides/*/; do \
      if [ -d "${pkg}" ] && [ -f "${pkg}/setup.cfg" -o -f "${pkg}/setup.py" -o -f "${pkg}/pyproject.toml" ]; then \
        pip3 wheel --no-cache-dir --no-deps --wheel-dir=/wheels/pkgs "${pkg}"; \
      fi; \
    done

# Build wheels for all dependencies from the lockfile
RUN pip3 wheel --no-cache-dir --no-deps \
      --find-links=/wheels/pkgs \
      --wheel-dir=/wheels/deps -r /deps-upper-constraints.txt

# Generate build manifest
RUN for src_dir in /src/*/ /src/overrides/*/; do \
      if [ -d "${src_dir}" ] && [ -f "${src_dir}/setup.cfg" ]; then \
        pkg_name=$(grep -m1 '^name' "${src_dir}/setup.cfg" | sed 's/.*=\s*//'); \
        commit=$(git -C "${src_dir}" rev-parse HEAD 2>/dev/null || echo "unknown"); \
        version=$(ls /wheels/pkgs/${pkg_name//-/_}-*.whl 2>/dev/null | head -1 | sed 's/.*-\([0-9][^-]*\)-.*/\1/' || echo "unknown"); \
        echo "${pkg_name},${commit},${version}"; \
      fi; \
    done > /source-built-packages.txt

# --- Runtime stage ---
FROM ${BASE_IMAGE}

LABEL summary="OpenStack Tempest All" \
      io.k8s.description="Tempest + full plugin set built from source, kolla interface"

# Create the tempest user (UID 42480, group kolla)
RUN uid_gid_manage tempest

# Install non-Python system dependencies
COPY tempest-all/bindeps.txt /tmp/bindeps.txt
RUN pkgs=$(cat /tmp/bindeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all; fi && rm /tmp/bindeps.txt

# Install source-built wheels (tempest + all plugins) + their deps
COPY --from=build /wheels /wheels
COPY --from=build /tmp/build-constraints.txt /deps-upper-constraints.txt
COPY --from=build /source-built-packages.txt /source-built-packages.txt
COPY tempest-all/pythondeps.txt /tmp/pythondeps.txt
# Install source wheels without dep resolution — plugins have inter-dependencies
# (e.g. manila/whitebox pin barbican-tempest-plugin==X) that conflict with source versions.
# --no-deps is safe here because all transitive deps are pre-built in /wheels/deps/.
RUN pip3 install --no-cache-dir --prefix=/usr --no-deps \
      --find-links=/wheels/pkgs \
      /wheels/pkgs/*.whl
# Install all transitive deps from the lockfile (source packages already filtered out)
RUN extrapkgs=$(cat /tmp/pythondeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    pip3 install --no-cache-dir --prefix=/usr \
      -c /deps-upper-constraints.txt \
      --find-links=/wheels/deps \
      --find-links=/wheels/pkgs \
      -r /deps-upper-constraints.txt ${extrapkgs} && \
    rm -rf /wheels /tmp/pythondeps.txt

# Create required runtime directories
RUN mkdir -p /var/lib/tempest/external_files \
             /var/lib/kolla/config_files && \
    touch /var/lib/kolla/config_files/config.json && \
    chown -R tempest:tempest /var/lib/tempest

# Install entrypoint script and sudoers
COPY common/config/usr/local/bin/run_tempest.sh /usr/local/bin/run_tempest.sh
COPY common/config/etc/sudoers.d/tempest_sudoers /etc/sudoers.d/tempest_sudoers

RUN chmod +x /usr/local/bin/run_tempest.sh && \
    chmod 440 /etc/sudoers.d/tempest_sudoers

ENV USE_EXTERNAL_FILES=true

ENTRYPOINT ["/usr/local/bin/run_tempest.sh"]

USER tempest
